<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <in.co.washing_machine.mushroomscanner.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/layout_notification_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#99000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_overlay_notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="通知区域"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_settings_menu"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#F0F0F0"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="🛠️ 扫描配置"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_config_region"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#2196F3"
            android:text="1. 设置扫描区域" />

        <Button
            android:id="@+id/btn_config_gesture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#FF9800"
            android:text="2. 录制上划手势" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="3. 滑动后等待 (ms):" />

        <EditText
            android:id="@+id/et_wait_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:inputType="number"
            android:padding="8dp"
            android:text="200" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_close_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#AAAAAA"
                android:text="取消" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_save_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#4CAF50"
                android:text="保存配置" />
        </LinearLayout>
    </LinearLayout>


    <View
        android:id="@+id/view_dim_top"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#80000000"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/handle_top"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#44000000"
        android:scaleType="center"
        android:src="@drawable/ic_drag_handle"
        android:visibility="gone" />

    <View
        android:id="@+id/view_dim_bottom"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:background="#80000000"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/handle_bottom"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="100dp"
        android:background="#44000000"
        android:scaleType="center"
        android:src="@drawable/ic_drag_handle"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_config_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#AA000000"
        android:gravity="center"
        android:padding="16dp"
        android:text="↕️ 拖动调整扫描区域\n完成后点击下方按钮"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_confirm_region"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="40dp"
        android:text="完成设置"
        android:visibility="gone" />


    <View
        android:id="@+id/view_gesture_touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_gesture_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#AA000000"
        android:gravity="center"
        android:padding="16dp"
        android:text="👆 请在屏幕上执行一次【上划翻页】\n我们将记录并回放您的操作"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_gesture_confirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DDFFFFFF"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="已记录手势"
            android:textColor="#000000"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn_retry_gesture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#FF9800"
                android:text="重试" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_confirm_gesture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#4CAF50"
                android:text="确认使用" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>